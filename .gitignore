CLAUDE.md*
*:Zone.Identifier

# Python
__pycache__/
*.pyc
.venv/
venv/

# Data / model weights (kept out of git; use .gitkeep to preserve dirs)
data/*
data/frames/
!data/*/
!data/*/.gitkeep
models/
*.pt
*.bin
*.pth
*.ckpt
outputs/
*.png
*.jpg
*.mov
*.json
*.obj

# COLMAP / pipeline run outputs (regenerated by roommodel/pose_estimation, etc.)
workspace/
*.rrd
*.db

# Open3D viewer artifacts (dumped to cwd when a hotkey is pressed in
# draw_geometries, e.g. from scripts/run_depth_single_image.py)
ScreenCamera_*.json
ScreenCapture_*.png
DepthCamera_*.json
DepthCapture_*.png

# Miscellaneous
.vscode/
*.log
*.tmp
**.pyc